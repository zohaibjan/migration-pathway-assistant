# ============================================================
# Migration Assist - Environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ============================================================

# Supabase - Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenAI / LLM API key goes in Supabase Edge Function secrets ONLY:
#   supabase secrets set OPENAI_API_KEY=sk-...
# Never place it here or in any client-side file.

# Hosted preview/production builds: configure the two EXPO_PUBLIC_SUPABASE_*
# values in the build environment before building; eas.json has no project keys.

# Optional live browser tests: use a dedicated non-production account.
# Export these variables in your shell before invoking the Node test scripts.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
